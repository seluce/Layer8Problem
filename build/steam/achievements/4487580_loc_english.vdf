	"Tokens"
	{
		"NEW_ACHIEVEMENT_1_0_NAME"	"The Ascetic"
		"NEW_ACHIEVEMENT_1_0_DESC"	"Get through almost the whole day without touching the 'black gold'."
		"NEW_ACHIEVEMENT_1_1_NAME"	"Palpitations"
		"NEW_ACHIEVEMENT_1_1_DESC"	"Drink a medically inadvisable quantity of coffee in one day."
		"NEW_ACHIEVEMENT_1_2_NAME"	"Ghosting Pro"
		"NEW_ACHIEVEMENT_1_2_DESC"	"Leave your inbox well alone and ignore requests on principle."
		"NEW_ACHIEVEMENT_1_3_NAME"	"Loot Goblin"
		"NEW_ACHIEVEMENT_1_3_DESC"	"Collect everything that is not nailed down, until nothing more will fit."
		"NEW_ACHIEVEMENT_1_4_NAME"	"Sloth"
		"NEW_ACHIEVEMENT_1_4_DESC"	"Avoid work for so long that your productivity approaches zero."
		"NEW_ACHIEVEMENT_1_5_NAME"	"Pulse 180"
		"NEW_ACHIEVEMENT_1_5_DESC"	"Let yourself be provoked until you are on the very edge of losing it."
		"NEW_ACHIEVEMENT_1_6_NAME"	"MacGyver"
		"NEW_ACHIEVEMENT_1_6_DESC"	"Collect the complete tool set for technical emergencies."
		"NEW_ACHIEVEMENT_1_7_NAME"	"The Millionaire"
		"NEW_ACHIEVEMENT_1_7_DESC"	"Ignore common sense and the spam filter."
		"NEW_ACHIEVEMENT_1_8_NAME"	"Mr. Robot"
		"NEW_ACHIEVEMENT_1_8_DESC"	"Find a way to help yourself to illegal admin rights."
		"NEW_ACHIEVEMENT_1_9_NAME"	"Ninja"
		"NEW_ACHIEVEMENT_1_9_DESC"	"Stay completely under the radar until early afternoon."
		"NEW_ACHIEVEMENT_1_10_NAME"	"Zen Master"
		"NEW_ACHIEVEMENT_1_10_DESC"	"Reach the afternoon in a state of absolute inner peace."
		"NEW_ACHIEVEMENT_1_11_NAME"	"Swot"
		"NEW_ACHIEVEMENT_1_11_DESC"	"Work hard and keep your Laziness extremely low until just before clocking off."
		"NEW_ACHIEVEMENT_1_12_NAME"	"High-Wire Act"
		"NEW_ACHIEVEMENT_1_12_DESC"	"Finish the day at the absolute limit of the tickets you are allowed to leave open."
		"NEW_ACHIEVEMENT_1_13_NAME"	"Inbox Zero"
		"NEW_ACHIEVEMENT_1_13_DESC"	"Work through them! The ticket counter has to be empty."
		"NEW_ACHIEVEMENT_1_14_NAME"	"Dancing on the Volcano"
		"NEW_ACHIEVEMENT_1_14_DESC"	"End the day with maximum stress and maximum fury at the same time."
		"NEW_ACHIEVEMENT_1_15_NAME"	"The Mentor"
		"NEW_ACHIEVEMENT_1_15_DESC"	"Help the apprentice out of a tight spot in IT."
		"NEW_ACHIEVEMENT_1_16_NAME"	"Marketing Alliance"
		"NEW_ACHIEVEMENT_1_16_DESC"	"Strike a pact with the marketing department."
		"NEW_ACHIEVEMENT_1_17_NAME"	"Metal Queen"
		"NEW_ACHIEVEMENT_1_17_DESC"	"Save Reception from a nervous collapse."
		"NEW_ACHIEVEMENT_1_18_NAME"	"Keymaster"
		"NEW_ACHIEVEMENT_1_18_DESC"	"Win the caretaker's trust."
		"NEW_ACHIEVEMENT_1_19_NAME"	"The Closer"
		"NEW_ACHIEVEMENT_1_19_DESC"	"Help the sales team close when it counts."
		"NEW_ACHIEVEMENT_1_20_NAME"	"Cat Whisperer"
		"NEW_ACHIEVEMENT_1_20_DESC"	"Solve the cat problem in Accounts."
		"NEW_ACHIEVEMENT_1_21_NAME"	"The Historian"
		"NEW_ACHIEVEMENT_1_21_DESC"	"Find and read the secret history of the company."
		"NEW_ACHIEVEMENT_1_22_NAME"	"Wolf of Wall Street"
		"NEW_ACHIEVEMENT_1_22_DESC"	"Win the hard negotiation against the final boss."
		"NEW_ACHIEVEMENT_1_23_NAME"	"Synergy Veteran"
		"NEW_ACHIEVEMENT_1_23_DESC"	"Prove yourself on every level to earn the ultimate invitation."
		"NEW_ACHIEVEMENT_1_24_NAME"	"Weekended"
		"NEW_ACHIEVEMENT_1_24_DESC"	"Hold out until Miller goes into a weekend with nothing left owing."
		"NEW_ACHIEVEMENT_1_25_NAME"	"Cast Iron"
		"NEW_ACHIEVEMENT_1_25_DESC"	"Get through the long haul without once letting off steam or being asked in for a word."
		"NEW_ACHIEVEMENT_1_26_NAME"	"Clean Friday"
		"NEW_ACHIEVEMENT_1_26_DESC"	"Leave the office on the last day with nothing whatsoever left open."
