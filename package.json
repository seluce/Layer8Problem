{
  "name": "layer8problem",
  "version": "4.0.0",
  "description": "Layer8Problem - SysAdmin Survival Simulator",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint:data": "node tools/lint-data.mjs",
    "start": "npm run build && electron .",
    "start:dev": "electron .",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:linux": "npm run build && electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.layer8problem.game",
    "productName": "Layer8Problem",
    "directories": {
      "output": "release"
    },
    "files": [
      "docs/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "build/logo.ico"
    },
    "linux": {
      "target": "dir",
      "icon": "build/logo.png"
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "svelte": "^5.56.8",
    "tailwindcss": "^4.3.3",
    "vite": "^8.1.5"
  },
  "dependencies": {
    "steamworks.js": "^0.4.0"
  }
}
