{
  "name": "layer8problem",
  "version": "3.7.0",
  "description": "Layer8Problem - SysAdmin Survival Simulator",
  "main": "main.js",
  "scripts": {
    "lint:data": "node tools/lint-data.mjs",
    "css": "tailwindcss -i input.css -o assets/css/style.css",
    "css:build": "tailwindcss -i input.css -o assets/css/style.css --minify",
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:linux": "electron-builder --linux --x64"
  },
  "build": {
    "appId": "com.layer8problem.game",
    "productName": "Layer8Problem",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!tools${/*}",
      "!input.css",
      "!changelog.md",
      "!README.md"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/logo/logo.ico"
    },
    "linux": {
      "target": "dir",
      "icon": "assets/logo/logo.png"
    }
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "electron": "^41.2.0",
    "electron-builder": "^26.8.1",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "jsdom": "^30.0.0",
    "steamworks.js": "^0.4.0"
  }
}
